# Modèle de variables pour Docker Compose.
# Copier vers .env.docker (non versionné) et renseigner de vraies valeurs :
#   Copy-Item .env.docker.example .env.docker
# Ne jamais committer .env.docker.

NODE_ENV=production

# MongoDB (identifiants root du conteneur, lettres/chiffres uniquement pour l'URI)
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# Secret de signature JWT (ex. 64 caractères hexadécimaux aléatoires)
JWT_SECRET=

# Email (optionnel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS Twilio (optionnel)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
